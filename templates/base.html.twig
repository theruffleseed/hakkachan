<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#1c1a17">
        <title>{% block title %}HAKKACHAN{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}HAKKACHAN — an 18-seat Hakka dining residency in Kuala Lumpur, hosted at INTASEK.{% endblock %}">

        {% block og %}
            <meta property="og:title" content="{{ block('title') }}">
            <meta property="og:description" content="{{ block('meta_description') }}">
            <meta property="og:type" content="website">
        {% endblock %}

        {% block stylesheets %}
            {{ importmap('app') }}
        {% endblock %}

        {% block javascripts %}{% endblock %}

        {% block structured_data %}{% endblock %}
    </head>
    <body class="min-h-screen flex flex-col bg-bone text-charcoal font-sans antialiased">
        <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-charcoal focus:text-bone focus:px-4 focus:py-2">
            Skip to content
        </a>

        {% block nav %}
            {% include 'partials/_nav.html.twig' with { transparent: false } %}
        {% endblock %}

        <main id="main" class="flex-1">
            {% block body %}{% endblock %}
        </main>

        {% include 'partials/_footer.html.twig' %}
    </body>
</html>
