{% extends 'base.html.twig' %}

{% block title %}Reserve — Hakkachan{% endblock %}
{% block meta_description %}Reserve a seat at Hakkachan, an 18-seat dining residency in Kuala Lumpur.{% endblock %}

{% block body %}
    <section class="py-24 md:py-32">
        <div class="max-w-md mx-auto px-6 text-center">
            <p class="brand-mark text-xs text-brass mb-6">Reserve</p>
            <h1 class="text-4xl md:text-5xl font-light mb-6 text-charcoal">Reserve a Seat</h1>
            <p class="text-charcoal/70 leading-relaxed mb-10">
                RM{{ pricePerPax }} per pax, the full six-course set. Minimum {{ minPax }} pax per booking.
                Please arrive between 6:00pm&ndash;8:00pm, Fridays &amp; Saturdays.
                Bookings open {{ bookingWeeks }} weeks ahead.
            </p>

            {% for message in app.flashes('error') %}
                <p class="text-sm text-red-700 mb-6">{{ message }}</p>
            {% endfor %}

            {% if dates is empty %}
                <p class="text-charcoal/70 leading-relaxed">
                    No seatings currently open for booking — message us directly below.
                </p>
            {% else %}
                <form method="post" action="{{ path('app_reserve_checkout') }}" data-turbo="false"
                      data-controller="pax-options" data-pax-options-min-value="{{ minPax }}"
                      class="flex flex-col gap-4 text-left">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">

                    <label class="text-sm brand-mark text-charcoal/70">
                        Date
                        <select name="date" required
                                data-pax-options-target="date" data-action="pax-options#refresh"
                                class="mt-2 w-full border border-charcoal/30 px-4 py-3 text-charcoal bg-bone focus:outline-none focus:border-charcoal">
                            {% for option in dates %}
                                <option value="{{ option.date|date('Y-m-d') }}" data-remaining="{{ option.remaining }}">
                                    {{ option.date|date('D, j M Y') }} — {{ option.remaining }} seat{{ option.remaining != 1 ? 's' : '' }} left
                                </option>
                            {% endfor %}
                        </select>
                    </label>

                    <label class="text-sm brand-mark text-charcoal/70">
                        Number of guests
                        <select name="pax" required data-pax-options-target="pax"
                                class="mt-2 w-full border border-charcoal/30 px-4 py-3 text-charcoal bg-bone focus:outline-none focus:border-charcoal">
                            {# Populated by the pax-options controller; this is the no-JS fallback for the first date. #}
                            {% for n in minPax..(dates|first).remaining %}
                                <option value="{{ n }}">{{ n }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label class="text-sm brand-mark text-charcoal/70">
                        Name
                        <input type="text" name="name" required maxlength="255" autocomplete="name"
                               class="mt-2 w-full border border-charcoal/30 px-4 py-3 text-charcoal bg-bone focus:outline-none focus:border-charcoal">
                    </label>

                    <label class="text-sm brand-mark text-charcoal/70">
                        Phone (Optional)
                        <input type="tel" name="phone" maxlength="32" autocomplete="tel"
                               class="mt-2 w-full border border-charcoal/30 px-4 py-3 text-charcoal bg-bone focus:outline-none focus:border-charcoal">
                    </label>

                    <label class="text-sm brand-mark text-charcoal/70">
                        Email (Optional)
                        <input type="email" name="email" maxlength="255" autocomplete="email"
                               class="mt-2 w-full border border-charcoal/30 px-4 py-3 text-charcoal bg-bone focus:outline-none focus:border-charcoal">
                    </label>

                    <button type="submit"
                            class="mt-4 inline-block bg-brass text-charcoal px-8 py-3 text-sm brand-mark hover:bg-brass-dim transition-colors">
                        Proceed to Payment
                    </button>
                </form>
            {% endif %}

            <a href="https://wa.me/60127882550?text=Hi%20Hakkachan%2C%20I%27d%20like%20to%20reserve%20a%20seat."
               class="inline-block mt-8 bg-whatsapp text-white px-8 py-3 text-sm brand-mark hover:bg-whatsapp-dim transition-colors">
                Message us on WhatsApp
            </a>
        </div>
    </section>
{% endblock %}
