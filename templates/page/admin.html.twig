{% extends 'base.html.twig' %}

{% block title %}Bookings — Hakkachan{% endblock %}

{% block body %}
    <section class="py-24 md:py-28">
        <div class="max-w-4xl mx-auto px-6">
            <p class="brand-mark text-xs text-brass mb-6">Admin</p>
            <h1 class="text-4xl md:text-5xl font-light mb-2 text-charcoal">Upcoming Bookings</h1>
            <p class="text-charcoal/60 text-sm mb-12">
                {{ bookings|length }} paid booking{{ bookings|length == 1 ? '' : 's' }} &middot; {{ totalPax }} guest{{ totalPax == 1 ? '' : 's' }}
            </p>

            {% for message in app.flashes('notice') %}
                <p class="text-sm text-brass-dim mb-6">{{ message }}</p>
            {% endfor %}

            {% if bookings is empty %}
                <p class="text-charcoal/70">No paid bookings for any upcoming seating.</p>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="brand-mark text-xs text-charcoal/50 border-b border-charcoal/15">
                            <tr>
                                <th class="py-3 pr-4 font-normal">Seating</th>
                                <th class="py-3 pr-4 font-normal">Guest</th>
                                <th class="py-3 pr-4 font-normal">Contact</th>
                                <th class="py-3 pr-4 font-normal text-right">Pax</th>
                                <th class="py-3 pr-4 font-normal text-right">Paid</th>
                                <th class="py-3 font-normal text-right"><span class="sr-only">Edit</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for booking in bookings %}
                                <tr class="border-b border-charcoal/10 align-top">
                                    <td class="py-4 pr-4 whitespace-nowrap">{{ booking.seatingDate|date('D, j M Y') }}</td>
                                    <td class="py-4 pr-4">{{ booking.guestName ?? '—' }}</td>
                                    <td class="py-4 pr-4 text-charcoal/70">
                                        {{ booking.guestPhone ?? '—' }}<br>
                                        {{ booking.guestEmail ?? '—' }}
                                    </td>
                                    <td class="py-4 pr-4 text-right">{{ booking.pax }}</td>
                                    <td class="py-4 pr-4 text-right whitespace-nowrap">RM{{ (booking.amountCents / 100)|number_format(2) }}</td>
                                    <td class="py-4 text-right whitespace-nowrap">
                                        <a href="{{ path('app_admin_edit', { id: booking.id }) }}" class="text-brass hover:underline">Edit</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
